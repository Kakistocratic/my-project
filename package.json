{
  "name": "my-project",
  "version": "1.0.0",
  "description": "Ecommerce template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "stripe-webhooks": "stripe listen --forward-to localhost:3000/api/stripe/webhooks",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.58.0",
    "@payloadcms/db-postgres": "3.58.0",
    "@payloadcms/email-nodemailer": "3.58.0",
    "@payloadcms/live-preview-react": "3.58.0",
    "@payloadcms/next": "3.58.0",
    "@payloadcms/plugin-ecommerce": "3.58.0",
    "@payloadcms/plugin-form-builder": "3.58.0",
    "@payloadcms/plugin-seo": "3.58.0",
    "@payloadcms/richtext-lexical": "3.58.0",
    "@payloadcms/storage-s3": "^3.69.0",
    "@payloadcms/translations": "3.58.0",
    "@payloadcms/ui": "3.58.0",
    "@radix-ui/react-accordion": "1.2.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^4.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.5.1",
    "graphql": "^16.12.0",
    "jsonwebtoken": "9.0.1",
    "lucide-react": "^0.477.0",
    "next": "^15.5.9",
    "next-themes": "0.4.6",
    "payload": "3.58.0",
    "prism-react-renderer": "^2.4.1",
    "qs-esm": "^7.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "7.54.1",
    "sharp": "0.32.6",
    "sonner": "^1.7.4",
    "stripe": "18.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@next/eslint-plugin-next": "^15.5.9",
    "@playwright/test": "1.50.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "4.0.12",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.5.4",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "@vercel/git-hooks": "^1.0.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.4.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "26.1.0",
    "lint-staged": "^15.5.2",
    "playwright": "1.50.0",
    "playwright-core": "1.50.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.18",
    "typescript": "5.7.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@vercel/git-hooks"
    ]
  }
}
